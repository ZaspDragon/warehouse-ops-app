rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userDocPath());
    }

    function myUserDoc() {
      return get(userDocPath());
    }

    function myRole() {
      return userExists() ? myUserDoc().data.role : null;
    }

    function isAdmin() {
      return signedIn() &&
        myRole() in ['admin', 'lead', 'platformOwner'];
    }

    function isManager() {
      return signedIn() &&
        myRole() == 'manager';
    }

    function canManageHistory() {
      return isAdmin() || isManager();
    }

    function isReceiverTemp() {
      return signedIn() &&
        myRole() == 'receiverTemp';
    }

    function isCounterRole() {
      return signedIn() &&
        myRole() in ['counter', 'worker', 'admin', 'lead', 'platformOwner'];
    }

    function isPlatformOwner() {
      return signedIn() &&
        myRole() == 'platformOwner';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasCreatedFields() {
      return request.resource.data.createdAt is string &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdByEmail is string;
    }

    function hasValidPutawayLog() {
      return hasCreatedFields() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.worker is string &&
        request.resource.data.date is string &&
        request.resource.data.putawayNumber is string &&
        request.resource.data.putawayNumber.size() > 0 &&
        request.resource.data.status in ['Completed', 'Pending Review', 'Imported'] &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0 &&
        request.resource.data.lineCount is int &&
        request.resource.data.lineCount > 0;
    }

    function hasValidPutawayActivity() {
      return hasCreatedFields() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type == 'putaway' &&
        request.resource.data.item is string &&
        request.resource.data.item.size() > 0 &&
        request.resource.data.putawayNumber is string &&
        request.resource.data.putawayNumber.size() > 0 &&
        request.resource.data.sourceCollection == 'putAwayLogs' &&
        request.resource.data.sourceId is string &&
        request.resource.data.status in ['Completed', 'Pending Review', 'Imported'];
    }

    function mySite() {
      return userExists() ? myUserDoc().data.site : null;
    }

    function myDepartment() {
      return userExists() ? myUserDoc().data.department : null;
    }

    function matchesMySiteDepartment(data) {
      return data.site == mySite() &&
        data.department == myDepartment();
    }

    function hasNoReceiverTempAdminFields() {
      return !request.resource.data.keys().hasAny([
        'receivedAt',
        'putawayCompletedAt',
        'dockToStockMinutes',
        'status',
        'approvedBy',
        'approvedAt',
        'completedBy',
        'completedAt',
        'adminNotes',
        'adminFields'
      ]);
    }

    // USERS
    match /users/{userId} {
      // Users can read their own profile.
      // Admins/leads/platformOwner can read all user profiles.
      allow read: if isOwner(userId) || isAdmin();

      // First-time user profile creation:
      // Allows a signed-in user to create only their own user profile,
      // but forces default worker-level role unless admin creates it.
      allow create: if
        (
          isOwner(userId) &&
          request.resource.data.role in ['worker', 'picker', 'counter'] &&
          request.resource.data.uid == request.auth.uid
        )
        || isAdmin();

      // Users cannot promote themselves.
      // Admins can update users.
      allow update: if isAdmin();

      // No client-side deletes.
      allow delete: if false;
    }

    // EMPLOYEES
    match /employees/{employeeId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // PUT AWAY LOGS
    match /putAwayLogs/{logId} {
      allow read: if signedIn();

      allow create: if signedIn() && !isReceiverTemp() && hasValidPutawayLog();

      allow update, delete: if canManageHistory();
    }

    // RECEIVING LINE ENTRY
    match /receivingLines/{lineId} {
      allow read: if isAdmin() ||
        (
          isReceiverTemp() &&
          resource.data.createdBy == request.auth.uid &&
          matchesMySiteDepartment(resource.data)
        );

      allow create: if isReceiverTemp() &&
        hasCreatedFields() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.lines is list &&
        matchesMySiteDepartment(request.resource.data) &&
        hasNoReceiverTempAdminFields();

      allow update: if isAdmin();

      allow delete: if false;
    }

    // CYCLE COUNT SESSIONS
    match /cycleCountSessions/{sessionId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    // CYCLE COUNT TEXT IMPORTS
    match /cycleCountImports/{importId} {
      allow read: if isAdmin() ||
        (
          isCounterRole() &&
          resource.data.createdBy == request.auth.uid
        );

      allow create: if
        (
          isCounterRole() &&
          !isAdmin() &&
          hasCreatedFields() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.rows is list &&
          request.resource.data.status in ['Draft', 'Pending Review']
        )
        ||
        (
          isAdmin() &&
          hasCreatedFields() &&
          request.resource.data.rows is list &&
          request.resource.data.status in ['Draft', 'Pending Review', 'Approved', 'Finalized']
        );

      allow update: if isAdmin() ||
        (
          isCounterRole() &&
          resource.data.createdBy == request.auth.uid &&
          resource.data.status in ['Draft', 'Pending Review'] &&
          request.resource.data.status in ['Draft', 'Pending Review'] &&
          request.resource.data.createdBy == resource.data.createdBy
        );

      allow delete: if isAdmin();
    }

    // ORDER PICKING SESSIONS
    match /orderPickingSessions/{sessionId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    // ACTIVITY LOGS
    match /activityLogs/{activityId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        (
          hasValidPutawayActivity() ||
          request.resource.data.type != 'putaway'
        );

      allow update, delete: if canManageHistory();
    }

    // AUDIT LOGS
    match /auditLogs/{auditId} {
      allow read: if isAdmin();

      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is string;

      allow update, delete: if false;
    }

    // LEGAL ACCEPTANCE AUDIT
    match /termsAcceptances/{acceptanceId} {
      allow read: if isAdmin();

      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.accepted == true &&
        request.resource.data.acceptedAt is string &&
        request.resource.data.version is string;

      allow delete: if false;
    }

    // TASKS
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // TRUCK LOGS
    match /truckLogs/{truckId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // INVENTORY COUNTS
    match /inventoryCounts/{countId} {
      allow read: if signedIn();

      allow create: if signedIn();

      allow update, delete: if isAdmin();
    }

    // QUALITY LOGS
    match /qualityLogs/{logId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // COACHING LOGS
    match /coachingLogs/{logId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // BLOCK EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
