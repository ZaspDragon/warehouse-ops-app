rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userDocPath());
    }

    function myUserDoc() {
      return get(userDocPath());
    }

    function myRole() {
      return userExists() ? myUserDoc().data.role : null;
    }

    function isAdmin() {
      return signedIn() && myRole() in ['admin', 'lead', 'platformOwner'];
    }

    function isReceiverTemp() {
      return signedIn() && myRole() == 'receiverTemp';
    }

    function isCounterRole() {
      return signedIn() && myRole() in ['counter', 'worker', 'admin', 'lead', 'platformOwner'];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasCreatedFields() {
      return request.resource.data.createdAt is string &&
        request.resource.data.createdBy is string &&
        request.resource.data.createdByEmail is string;
    }

    function isMyTenant(data) {
      return signedIn() &&
        (
          (data.ownerEmail is string && data.ownerEmail.lower() == authEmail()) ||
          (data.createdByEmail is string && data.createdByEmail.lower() == authEmail())
        );
    }

    function createsMyTenant() {
      return signedIn() &&
        request.resource.data.ownerEmail is string &&
        request.resource.data.ownerEmail.lower() == authEmail();
    }

    function keepsMyTenant() {
      return isMyTenant(resource.data) &&
        request.resource.data.ownerEmail is string &&
        request.resource.data.ownerEmail.lower() == authEmail();
    }

    function hasPutawaySubmitFields() {
      return (
          request.resource.data.worker is string &&
          request.resource.data.worker.size() > 0 &&
          request.resource.data.submittedAt is string &&
          request.resource.data.submittedDate is string &&
          request.resource.data.submittedTime is string
        ) ||
        (
          request.resource.data.branchId is string &&
          request.resource.data.employeeName is string &&
          request.resource.data.employeeName.size() > 0 &&
          request.resource.data.workDate is string &&
          request.resource.data.createdAt is string &&
          request.resource.data.updatedAt is string &&
          request.resource.data.totalLines is number &&
          request.resource.data.totalQty is number &&
          request.resource.data.lines is list
        );
    }

    function mySite() {
      return userExists() ? myUserDoc().data.site : null;
    }

    function myDepartment() {
      return userExists() ? myUserDoc().data.department : null;
    }

    function matchesMySiteDepartment(data) {
      return data.site == mySite() && data.department == myDepartment();
    }

    function hasNoReceiverTempAdminFields() {
      return !request.resource.data.keys().hasAny([
        'receivedAt',
        'putawayCompletedAt',
        'dockToStockMinutes',
        'status',
        'approvedBy',
        'approvedAt',
        'completedBy',
        'completedAt',
        'adminNotes',
        'adminFields'
      ]);
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if
        (
          isOwner(userId) &&
          request.resource.data.role in ['worker', 'picker', 'counter'] &&
          request.resource.data.uid == request.auth.uid
        )
        || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // EMPLOYEES - isolated per logged-in email/account.
    match /employees/{employeeId} {
      allow read: if isMyTenant(resource.data);
      allow create: if isAdmin() && createsMyTenant();
      allow update: if isAdmin() && keepsMyTenant();
      allow delete: if false;
    }

    // PUT AWAY LOGS - isolated per logged-in email/account and requires worker + submit timestamp.
    match /putAwayLogs/{logId} {
      allow read: if isMyTenant(resource.data);
      allow create: if signedIn() && !isReceiverTemp() && createsMyTenant() && hasPutawaySubmitFields();
      allow update: if signedIn() && !isReceiverTemp() && keepsMyTenant() && hasPutawaySubmitFields();
      allow delete: if isAdmin() && keepsMyTenant();
    }

    // RECEIVING LINE ENTRY
    match /receivingLines/{lineId} {
      allow read: if isAdmin() ||
        (
          isReceiverTemp() &&
          resource.data.createdBy == request.auth.uid &&
          matchesMySiteDepartment(resource.data)
        );

      allow create: if isReceiverTemp() &&
        hasCreatedFields() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.lines is list &&
        matchesMySiteDepartment(request.resource.data) &&
        hasNoReceiverTempAdminFields();

      allow update: if isAdmin();
      allow delete: if false;
    }

    // RETIRED WORKFLOWS - disabled because Cycle Count, Cycle Count Production, and Order Picking are removed.
    match /cycleCountSessions/{sessionId} {
      allow read, write: if false;
    }

    match /cycleCountImports/{importId} {
      allow read, write: if false;
    }

    match /orderPickingSessions/{sessionId} {
      allow read, write: if false;
    }

    // ACTIVITY LOGS - isolated per logged-in email/account.
    match /activityLogs/{activityId} {
      allow read: if isMyTenant(resource.data);
      allow create: if signedIn() && createsMyTenant();
      allow update, delete: if isAdmin() && keepsMyTenant();
    }

    // AUDIT LOGS
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    // LEGAL ACCEPTANCE AUDIT
    match /termsAcceptances/{acceptanceId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.accepted == true &&
        request.resource.data.acceptedAt is string &&
        request.resource.data.version is string;
      allow delete: if false;
    }

    // TASKS
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // TRUCK LOGS
    match /truckLogs/{truckId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // INVENTORY COUNTS
    match /inventoryCounts/{countId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // QUALITY LOGS
    match /qualityLogs/{logId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // COACHING LOGS
    match /coachingLogs/{logId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // BLOCK EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
